    {
      "id": "7acd8e09-3c2c-4fae-a3a7-352506b6ca5f",
      "name": "Dedup and Map Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        224
      ],
      "parameters": {
        "jsCode": "// Dedup in one pass: email rows -> Leads if email not already in Leads;\n// no-email rows -> Call List if phone not already in Call List.\nconst csvRows = $('Extract CSV Rows').all();\nconst leadsRows = $('Read Leads Tab').all();\nconst callRows = $('Read Call List Tab').all();\n\nconst normPhone = (p) => (p == null ? '' : String(p).replace(/\\D+/g, ''));\nconst normEmail = (e) => (e == null ? '' : String(e).trim().toLowerCase());\nconst clean = (v) => (v == null ? '' : String(v).trim());\nconst firstNonEmpty = (...vals) => {\n  for (const v of vals) {\n    const s = clean(v);\n    if (s) return s;\n  }\n  return '';\n};\n\nconst firstEmail = (raw) => {\n  const s = clean(raw);\n  if (!s) return '';\n  const parts = s.split(/[;,\\s]+/);\n  for (const part of parts) {\n    const e = normEmail(part);\n    if (/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(e)) return e;\n  }\n  return '';\n};\n\nconst BAD_HOST = /(?:^|\\.)(facebook\\.com|mapquest\\.com|yelp\\.com|google\\.[a-z.]+)(?:[/?#]|$)/i;\nconst pickWebsite = (website, googleFirstUrl) => {\n  const w = clean(website);\n  if (w) return w;\n  const g = clean(googleFirstUrl);\n  if (!g) return '';\n  return BAD_HOST.test(g) ? '' : g;\n};\n\n// email rows dedupe against Leads only; phone rows against Call List only\nconst existingEmails = new Set();\nfor (const r of leadsRows) {\n  if (!r.json || Object.keys(r.json).length === 0) continue;\n  const e = normEmail(r.json.email);\n  if (e) existingEmails.add(e);\n}\nconst existingPhones = new Set();\nfor (const r of callRows) {\n  if (!r.json || Object.keys(r.json).length === 0) continue;\n  const p = normPhone(r.json.phone);\n  if (p) existingPhones.add(p);\n}\n\n// source column from the Drive file name\nconst fileName = clean($('New File in Leads Inbox').first().json.name);\nconst source = /apollo/i.test(fileName) ? 'apollo' : 'maps';\n\nconst today = new Date().toISOString().slice(0, 10);\nconst out = [];\nconst seenEmails = new Set();\nconst seenPhones = new Set();\nlet skipped = 0;\n\nfor (const row of csvRows) {\n  const j = row.json;\n  const email = firstEmail(firstNonEmpty(j.emails, j['emails/0'], j.email));\n  const phone = firstNonEmpty(j.phone_number, j.phone).replace(/\\s+/g, '').replace(/^\\+1/, '');\n  const phoneNorm = normPhone(phone);\n\n  if (email && email.endsWith('@facebook.com')) { skipped++; continue; }\n\n  if (email) {\n    // email row: dedupe on email against Leads only (do not check Call List)\n    if (existingEmails.has(email) || seenEmails.has(email)) { skipped++; continue; }\n  } else {\n    // no-email row: needs a phone not already in Call List\n    if (!phoneNorm || existingPhones.has(phoneNorm) || seenPhones.has(phoneNorm)) { skipped++; continue; }\n  }\n\n  if (email) seenEmails.add(email);\n  if (phoneNorm) seenPhones.add(phoneNorm);\n\n  const category = firstNonEmpty(j.business_category, j.categoryName).replace(/[_|]+/g, ' ').replace(/\\s+/g, ' ').trim();\n\n  const base = {\n    business_name: firstNonEmpty(j.name, j.title),\n    category,\n    city: clean(j.city),\n    phone,\n    website: pickWebsite(j.website, j.google_first_url),\n    rating: firstNonEmpty(j.review_score, j.totalScore),\n    reviews: clean(j.reviewsCount),\n    added_date: today,\n    source,\n  };\n\n  if (email) {\n    out.push({ json: { ...base,\n      email,\n      facebook: firstNonEmpty(j.facebook, j['facebooks/0']),\n      instagram: firstNonEmpty(j.instagram, j['instagrams/0']),\n      status: '',\n      last_sent: '',\n      dest: 'leads' } });\n  } else {\n    out.push({ json: { ...base, dest: 'calllist' } });\n  }\n}\n\nout.push({ json: { dest: 'summary', added_leads: out.filter(o => o.json.dest === 'leads').length, added_calllist: out.filter(o => o.json.dest === 'calllist').length, skipped, file_name: fileName } });\nreturn out;"
      }
    },
    {
      "id": "fa1443bc-bf15-494c-a4f5-9f929d9dae5b",
      "name": "Route by Destination",
      "type": "n8n-nodes-base.switch",
