      "id": "3ffe7b7a-a72c-4794-b767-12e5cfcf220a",
      "name": "Read Leads Tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        272,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract sender from the email, match against the Leads tab, classify the reply.\nconst email = $('New Reply Email').item.json;\nconst leads = $input.all();\n\n// Extract sender address from the From header, lowercase and trim.\nconst fromRaw = email.from; const fromHeader = (typeof fromRaw === 'string' ? fromRaw : ((fromRaw && fromRaw.value && fromRaw.value[0] && fromRaw.value[0].address) || (fromRaw && fromRaw.text) || email.From || '')).toString().toLowerCase();\nconst angleMatch = fromHeader.match(/<([^>]+)>/);\nconst sender = (angleMatch ? angleMatch[1] : fromHeader).trim();\nif (!sender || !sender.includes('@')) return []; // no parseable sender\n\nconst subject = (email.subject || '').toString();\nconst rawBody = (email.text || email.snippet || '').toString(); const body = rawBody.split(/\\n\\s*On [\\s\\S]{0,400}?wrote:/)[0].split(/\\r?\\n/).filter(l => !l.trim().startsWith('>')).join('\\n').split(/Not interested\\? Reply stop/i)[0];\nconst haystack = (subject + ' ' + body).toLowerCase();\n\n// 1) Bounce detection: system sender or bounce subject phrases\nconst bounceSenders = ['mailer-daemon', 'postmaster'];\nconst bounceSubjects = ['delivery status notification', 'undeliverable', 'mail delivery failed', 'address not found'];\nconst isBounce =\n  bounceSenders.some((s) => sender.includes(s)) ||\n  bounceSubjects.some((p) => subject.toLowerCase().includes(p));\n\nif (isBounce) {\n  // Extract the failed recipient address from the bounce body (first address that is not the sender/system)\n  const addrs = rawBody.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+.[A-Za-z]{2,}/g) || [];\n  const failed = addrs.find((a) => {\n    const la = a.toLowerCase();\n    return !la.includes('mailer-daemon') && !la.includes('postmaster') && la !== sender;\n  }) || '';\n  const failedEmail = failed.toLowerCase();\n  if (!failedEmail) return []; // cannot tell who bounced\n  let lead = null;\n  for (const item of leads) {\n    const e = (item.json.email || '').toString().trim().toLowerCase();\n    if (e && e === failedEmail) { lead = item.json; break; }\n  }\n  if (!lead) return []; // bounced address not in Leads\n  return [{ json: {\n    sender: failedEmail,\n    business_name: lead.business_name || '',\n    lead_email: failedEmail,\n    row_number: lead.row_number,\n    category: 'bounced',\n    new_status: 'bounced',\n    subject,\n    message_text: body.trim(),\n  } }];\n}\n\n// For non-bounces the sender must be a known lead\nlet lead = null;\nfor (const item of leads) {\n  const e = (item.json.email || '').toString().trim().toLowerCase();\n  if (e && e === sender) { lead = item.json; break; }\n}\nif (!lead) return []; // unknown sender: no-op\n\n// 2) Out of office: do nothing, do not mark replied\nconst oooWords = ['out of office', 'automatic reply', 'auto reply', 'on vacation', 'away until'];\nconst isOoo = oooWords.some((w) => haystack.includes(w));\n\n// 3) Unsubscribe / stop requests\nconst unsubWords = ['stop', 'unsubscribe', 'remove me', 'not interested', 'unsubscribe me', 'take me off', 'wrong person', \"don't email\", 'dont email', 'do not email'];\nconst isUnsub = unsubWords.some((w) => haystack.includes(w));\n\nconst category = isOoo ? 'ooo' : (isUnsub ? 'unsub' : 'replied');\n\nreturn [{ json: {\n  sender,\n  business_name: lead.business_name || '',\n  lead_email: sender,\n  row_number: lead.row_number,\n  category,\n  new_status: category === 'unsub' ? 'unsub' : (category === 'replied' ? 'replied' : ''),\n  subject,\n  message_text: body.trim(),\n} }];"
      },
