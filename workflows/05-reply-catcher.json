      "id": "f52c17c0-b22d-4c80-ad0f-ac2d6b8b95e1",
      "name": "Mark Lead Bounced",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1024,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "// Count leads with status \"bounced\" whose last_sent is today. Runs once per bounce.\nconst leads = $('Read Leads Tab').all();\nconst bouncedInfo = $('Match Sender and Classify').item.json;\nconst today = new Date().toISOString().slice(0, 10); // YYYY-MM-DD (UTC)\nlet count = 0;\nfor (const item of leads) {\n  const j = item.json;\n  const st = (j.status || '').toString().trim().toLowerCase();\n  const ls = (j.last_sent || '').toString().trim();\n  if (st === 'bounced' && ls.startsWith(today)) count++;\n}\n// The just-marked bounce may not be reflected in the sheet snapshot yet — make sure it is counted.\nconst justMarked = (bouncedInfo.new_status || '') === 'bounced';\nconst alreadyCounted = leads.some((item) => {\n  const e = (item.json.email || '').toString().trim().toLowerCase();\n  const st = (item.json.status || '').toString().trim().toLowerCase();\n  const ls = (item.json.last_sent || '').toString().trim();\n  return e === bouncedInfo.lead_email && st === 'bounced' && ls.startsWith(today);\n});\nif (justMarked && !alreadyCounted) count++;\nreturn [{ json: { bounce_count_today: count, pause_needed: count >= 2, business_name: bouncedInfo.business_name, lead_email: bouncedInfo.lead_email } }];"
      },
