    {
      "id": "45e33190-6b36-4139-b393-f4a2bf5255f1",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        576
      ],
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map((i) => i.json)\n  .filter((j) => j && Object.keys(j).length > 0 && Object.values(j).some((v) => v !== null && v !== undefined && String(v).trim() !== ''));\n\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });\n\nconst due = rows.filter((r) => {\n  const stage = String(r.stage || '').trim();\n  const nad = String(r.next_action_date || '').trim();\n  if (stage === 'Won' || stage === 'Lost') return false;\n  if (nad === '') return false;\n  const d = new Date(nad);\n  if (isNaN(d.getTime())) return false;\n  const ny = new Date(d.getTime() + (nad.length <= 10 ? 12 * 3600 * 1000 : 0));\n  return ny.toLocaleDateString('en-CA', { timeZone: 'America/New_York' }) === today;\n});\n\nif (due.length === 0) return [];\n\nconst esc = (s) => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst items = due.map((r) =>\n  '<li><strong>' + esc(r.business_name) + '</strong>'\n  + ' &mdash; Stage: ' + esc(r.stage)\n  + ' | Owner: ' + esc(r.owner)\n  + ' | Next action: ' + esc(r.next_action)\n  + ' | Phone: ' + esc(r.phone)\n  + '</li>'\n);\n\nconst html = '<h2>RLD follow-ups for ' + today + '</h2><ul>' + items.join('\\n') + '</ul>';\n\nreturn [{ json: { count: due.length, subject: 'RLD follow-ups today: ' + due.length, html } }];"
      }
    },
