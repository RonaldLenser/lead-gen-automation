    {
      "id": "cabb60cc-b65b-4425-b3a6-71bceb432142",
      "name": "Find New Entries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        352
      ],
      "parameters": {
        "jsCode": "const clean = (items) => items\n  .map((i) => i.json)\n  .filter((j) => j && Object.keys(j).length > 0 && Object.values(j).some((v) => v !== null && v !== undefined && String(v).trim() !== ''));\n\nconst leads = clean($('Read Leads').all());\nconst calls = clean($('Read Call List').all());\nconst pipeline = clean($('Read Pipeline').all());\n\nconst pipelineEmails = new Set(\n  pipeline.map((p) => String(p.email || '').trim().toLowerCase()).filter((e) => e !== '')\n);\nconst pipelinePhones = new Set(\n  pipeline.map((p) => String(p.phone || '').replace(/\\D/g, '')).filter((p) => p !== '')\n);\n\nconst today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' });\nconst out = [];\n\nfor (const lead of leads) {\n  const email = String(lead.email || '').trim().toLowerCase();\n  const status = String(lead.status || '').trim().toLowerCase();\n  if (status === 'replied' && email !== '' && !pipelineEmails.has(email)) {\n    out.push({\n      business_name: String(lead.business_name || ''),\n      contact_name: String(lead.contact_name || ''),\n      phone: String(lead.phone || ''),\n      email: String(lead.email || '').trim(),\n      source: String(lead.source || ''),\n      stage: 'Replied',\n      owner: String(lead.owner || ''),\n      deal_value: String(lead.deal_value || ''),\n      next_action: 'Reply + send mockup',\n      next_action_date: today,\n      notes: String(lead.notes || ''),\n      added_date: today,\n      closed_date: '',\n    });\n    pipelineEmails.add(email);\n  }\n}\n\nfor (const call of calls) {\n  const phoneDigits = String(call.phone || '').replace(/\\D/g, '');\n  const outcome = String(call.outcome || '').trim().toLowerCase();\n  if (outcome === 'interested' && phoneDigits !== '' && !pipelinePhones.has(phoneDigits)) {\n    out.push({\n      business_name: String(call.business_name || ''),\n      contact_name: String(call.contact_name || ''),\n      phone: String(call.phone || ''),\n      email: String(call.email || '').trim(),\n      source: 'Call',\n      stage: 'Interested',\n      owner: String(call.owner || ''),\n      deal_value: '',\n      next_action: 'Build mockup + book call',\n      next_action_date: today,\n      notes: String(call.notes || ''),\n      added_date: today,\n      closed_date: '',\n    });\n    pipelinePhones.add(phoneDigits);\n  }\n}\n\nreturn out.map((j) => ({ json: j }));"
      }
    },
